config oscillatorType:
    'triangle' | 'sawtooth' | 'square' | 'parabolic' = 'triangle'

fn on(
    destination: AudioNode,
    start: Instant,
    pitch: AudioSignal<Pitch>,
    velocity: Level,
    attack: Duration = 1ms,
    decay: Duration = 200ms,
    sustain: Level = 70%,  # Ignored
    release: Duration = 50ms,
):
    if oscillatorType == 'triangle':
        osc = SoftTriangleNode(bite = 100%)
    elif oscillatorType == 'sawtooth':
        osc = SoftSawtoothNode(bite = 100%)
    elif oscillatorType == 'square':
        osc = SoftSquareNode(bite = 100%)
    else:
        osc = SoftParabolicNode(bite = 100%)
    osc.start(start)
    @start osc.bite = 100%
    @(start;target decay) osc.bite = 0%

    attackEnv = GainNode(gain = 0)
    @start attackEnv.gain = 0
    @(start + attack; linear) attackEnv.gain = velocity
    env = GainNode(gain = 1)
    @start env.gain = 1
    @(start;target decay) env.gain = 0

    until osc:ended:
        osc -> attackEnv -> env -> destination
        pitch -> osc.detune

    ret once fn off(end: Instant):
        @(end; hold) env.gain
        @(end; target release) env.gain = 0
        cutOff = end + 5 * release
        osc.stop(cutOff)
        ret cutOff
