config delayTime: Duration = 250ms
config feedback: Level = 55%
config wet: Level = 35%

input = GainNode()
output = GainNode()
dry = GainNode(gain = 1 - wet)
wetOutput = GainNode(gain = wet)
leftDelay = DelayNode(maxDelayTime = 2s, delayTime = delayTime)
rightDelay = DelayNode(maxDelayTime = 2s, delayTime = delayTime)
leftFeedback = GainNode(gain = feedback)
rightFeedback = GainNode(gain = feedback)
merger = ChannelMergerNode(numberOfInputs = 2)

input -> dry -> output
input -> leftDelay
leftDelay:0 -> merger:0
rightDelay:0 -> merger:1
leftDelay -> rightFeedback -> rightDelay
rightDelay -> leftFeedback -> leftDelay
merger -> wetOutput -> output
