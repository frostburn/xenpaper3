config delayTime: Duration = 250ms
config feedback: Level = 55%
config wet: Level = 35%

input = GainNode()
output = GainNode()

leftDelay = DelayNode(maxDelayTime = 2s)
rightDelay = DelayNode(maxDelayTime = 2s)
merger = ChannelMergerNode(numberOfInputs = 2)

AudioSignal(delayTime) -> leftDelay.delayTime
AudioSignal(delayTime) -> rightDelay.delayTime

input * (1 - wet) -> output
input -> leftDelay
leftDelay:0 -> merger:0
rightDelay:0 -> merger:1
leftDelay * feedback -> rightDelay
rightDelay * feedback -> leftDelay
merger * wet -> output
