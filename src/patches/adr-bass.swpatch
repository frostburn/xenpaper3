config oscillatorType:
    'sine' | 'square' | 'sawtooth' | 'triangle' = 'sawtooth'

fn on(
    destination: AudioNode,
    start: Instant,
    pitch: AudioSignal<Cents>,
    velocity: Level,
    attack: Duration = 10ms,
    decay: Duration = 500ms,
    release: Duration = 100ms,
    Q: Gain = +5dB,
):
    osc = OscillatorNode(type = oscillatorType)
    lpf = BiquadFilterNode(
        type = 'lowpass',
        frequency = 300Hz * (1 + velocity),
        Q = Q
    )
    attackEnv = GainNode(gain = 0)
    initialGain = 10dB - Q
    decayEnv = GainNode(gain = initialGain)

    pitchAttenuation = GainNode(gain = 0.7)

    until osc.ended:
        osc -> lpf -> attackEnv -> decayEnv -> destination
        pitch -> osc.detune
        pitch -> pitchAttenuation -> lpf.detune

    osc.start(start)

    @(start; target decay) lpf.frequency = 20Hz * (1 + velocity)

    @(start) attackEnv.gain = 0
    @(start + attack; linear) attackEnv.gain = velocity

    @(start) decayEnv.gain = initialGain
    @(start; target decay) decayEnv.gain = 0

    ret once fn off(end: Instant):
        @(end; hold) attackEnv.gain
        @(end; hold) decayEnv.gain
        @(end; target release) decayEnv.gain = 0

        cutOff = end + 5 * release
        osc.stop(cutOff)

        ret cutOff
