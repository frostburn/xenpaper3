{
  "name": "xenpaper3",
  "version": "3.0.0-beta.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "run-s compile:sw-patch compile:xenpaper-lang && vite",
    "build": "run-s compile:sw-patch compile:xenpaper-lang && run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "run-p compile:sw-patch compile:xenpaper-lang && vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "oxfmt src/ xenpaper-lang/ sw-patch/ sw-seq/",
    "compile:sw-patch": "peggy --format es sw-patch/sw-patch.peggy -o sw-patch/parser.generated.js",
    "compile:xenpaper-lang": "peggy --format es xenpaper-lang/xenpaper.peggy -o xenpaper-lang/parser.generated.js"
  },
  "dependencies": {
    "aperiodic-oscillator": "^0.3.3",
    "moment-of-symmetry": "^0.10.0",
    "peggy": "^5.1.0",
    "pinia": "^4.0.2",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "xen-dev-utils": "^0.16.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "^1.6.23",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.2.7",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.73.0",
    "eslint-plugin-vue": "~10.9.2",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^9.0.2",
    "oxfmt": "^0.59.0",
    "oxlint": "~1.73.0",
    "typescript": "~6.0.0",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.7"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
